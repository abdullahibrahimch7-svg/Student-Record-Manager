rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsAccount(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }

    match /users/{accountId}/students/{studentId} {
      allow read, delete: if ownsAccount(accountId);
      allow create, update: if ownsAccount(accountId)
        && request.resource.data.keys().hasOnly(['name', 'subjects'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 200;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
